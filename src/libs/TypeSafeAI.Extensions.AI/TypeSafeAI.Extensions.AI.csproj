<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>tryAGI.TypeSafeAI.Extensions.AI</PackageId>
    <Title>TypeSafeAI Microsoft.Extensions.AI integrations</Title>
    <Description>Compatibility facade. All integrations are now included in tryAGI.TypeSafeAI; new applications need only that package.</Description>
    <PackageTags>typesafe-ai;microsoft-extensions-ai;guardrails;routing;evaluation;ai</PackageTags>
    <PackageProjectUrl>https://github.com/tryAGI/TypeSafeAI</PackageProjectUrl>
    <RepositoryUrl>https://github.com/tryAGI/TypeSafeAI</RepositoryUrl>
    <NoWarn>$(NoWarn);CS1591;CS3001;CS3002;CS3003;CS3009;MEAI001;CA1032;CA1034;CA1062;CA1308;CA1710;CA1815;CA1819;CA1822;CA1848;CA1859;CA2000;CA2215;CA2225</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\TypeSafeAI\TypeSafeAI.csproj" />
  </ItemGroup>
</Project>
